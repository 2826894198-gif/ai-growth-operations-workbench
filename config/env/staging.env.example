APP_ENV=staging
DATABASE_URL=postgresql+asyncpg://growth:CHANGE_ME@db:5432/growth
REDIS_URL=redis://redis:6379/0
SECRET_KEY=CHANGE_ME
EXECUTION_DEMO_PERMISSIONS=false
DATA_PROVIDER_MODE=mock
AI_PROVIDER_MODE=mock
SOCIAL_PROVIDER_MODE=mock
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_SYNC_ENABLED=false
INSTAGRAM_DEMO_MODE=false
INSTAGRAM_OAUTH_MODE=instagram_login
INSTAGRAM_APP_ID=CHANGE_ME
INSTAGRAM_APP_SECRET_REFERENCE=env:INSTAGRAM_APP_SECRET
INSTAGRAM_TOKEN_ENCRYPTION_KEY_REFERENCE=env:INSTAGRAM_TOKEN_ENCRYPTION_KEY
